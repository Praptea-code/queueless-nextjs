# PostgreSQL connection string (Supabase or Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/queueless"

# Supabase (used for realtime + server publishing)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Secret for the database webhook -> /api/webhooks/realtime
SUPABASE_WEBHOOK_SECRET=""

# Twilio SMS (stubbed until you add keys)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# AI provider (OpenAI or Anthropic) — used by /api/ai/* routes
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional: set to "false" to silence dev-only stub logging
ALLOW_STUB_LOGGING="true"